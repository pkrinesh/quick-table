{
  "name": "quick-table",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "dev": "bun run --filter playground dev",
    "build": "bun run --filter '@quick-table/*' build",
    "build:all": "bun run build && bun run --filter playground build",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "rm -rf packages/*/dist playground/dist node_modules/.cache",
    "prepare": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/bun": "1.3.5",
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
